# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to Git.

# ── Production (Vercel) ────────────────────────────────────────────────────
# Set these in the Vercel dashboard under Project → Settings → Environment Variables.
#
# HTTP REST base URL for the deployed backend (Railway / Render / Fly.io).
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# WebSocket base URL for the deployed backend (same host, wss:// scheme).
NEXT_PUBLIC_WS_URL=wss://your-backend.up.railway.app

# ── Local development ──────────────────────────────────────────────────────
# Uncomment these two lines (and comment out the production lines above)
# when running the backend locally with uvicorn.
#
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
